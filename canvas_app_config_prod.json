{
  "title": "UWIT JupyterHub for Teaching",
  "description": "JupyterHub for Teaching gives users access to Jupyter Notebook environments (computational environments and resources) without the hassle of installation and maintenance tasks.",
  "custom_fields": {
    "application_type": "ViewStudentProfile",
    "userid_parameter": "lis_person_sourcedid",
    "courseid_parameter": "lis_course_offering_sourcedid",
    "custom_canvas_user_id": "$Canvas.user.id",
    "custom_canvas_login_id": "$Canvas.user.loginId",
    "custom_canvas_course_id": "$Canvas.course.id",
    "custom_canvas_account_id": "$Canvas.account.id",
    "custom_canvas_api_domain": "$Canvas.api.domain",
    "custom_canvas_account_sis_id": "$Canvas.account.sisSourceId"
  },
  "target_link_uri": "https://jupyter.rttl.uw.edu/rttlinfo/",
  "domain": "",
  "tool_id": "",
  "privacy_level": "public",
  "oidc_initiation_url": "https://jupyter.rttl.uw.edu/rttlinfo/blti/login",
  "oidc_initiation_urls": {},
  "public_jwk": null,
  "public_jwk_url": "https://jupyter.rttl.uw.edu/rttlinfo/blti/jwks",
  "scopes": [
    "https://purl.imsglobal.org/spec/lti-nrps/scope/contextmembership.readonly"
  ],
  "redirect_uris": [
    "https://jupyter.rttl.uw.edu/rttlinfo/"
  ],
  "launch_settings": {
    "custom_fields": {
      "application_type": "ViewStudentProfile",
      "userid_parameter": "lis_person_sourcedid",
      "courseid_parameter": "lis_course_offering_sourcedid",
      "custom_canvas_user_id": "$Canvas.user.id",
      "custom_canvas_login_id": "$Canvas.user.loginId",
      "custom_canvas_course_id": "$Canvas.course.id",
      "custom_canvas_account_id": "$Canvas.account.id",
      "custom_canvas_api_domain": "$Canvas.api.domain",
      "custom_canvas_account_sis_id": "$Canvas.account.sisSourceId"
    },
    "target_link_uri": "https://jupyter.rttl.uw.edu/rttlinfo/"
  },
  "placements": [
    {
      "message_type": "LtiResourceLinkRequest",
      "default": "disabled",
      "placement": "course_navigation"
    }
  ]
}
